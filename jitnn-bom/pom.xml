<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- No parent on purpose: importing this BOM brings only jitNN's own module versions, not the
         parent's managed TornadoVM, DJL and JUnit versions. -->
    <groupId>ai.beestream</groupId>
    <artifactId>jitnn-bom</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>jitNN BOM</name>
    <description>Bill of materials: import it in dependencyManagement to use jitNN modules of one version without repeating it</description>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>ai.beestream</groupId>
                <artifactId>jitnn-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ai.beestream</groupId>
                <artifactId>jitnn-nn</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ai.beestream</groupId>
                <artifactId>jitnn-onnx</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ai.beestream</groupId>
                <artifactId>jitnn-tf</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ai.beestream</groupId>
                <artifactId>jitnn-gguf</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ai.beestream</groupId>
                <artifactId>jitnn-djl</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
