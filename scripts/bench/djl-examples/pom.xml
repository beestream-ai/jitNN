<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>org.beehive.jitnn.bench</groupId>
    <artifactId>djl-examples-bench</artifactId>
    <version>1</version>
    <name>DJL's examples on jitNN and on DJL's PyTorch and OnnxRuntime engines</name>

    <!-- The example sources are copied unchanged from a DJL checkout by run.sh (examples/src/main/java). -->
    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <djl.version>0.38.0</djl.version>
        <ort.version>1.30.0</ort.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>ai.djl</groupId>
            <artifactId>api</artifactId>
            <version>${djl.version}</version>
        </dependency>
        <dependency>
            <groupId>ai.djl</groupId>
            <artifactId>basicdataset</artifactId>
            <version>${djl.version}</version>
        </dependency>
        <dependency>
            <groupId>ai.djl</groupId>
            <artifactId>model-zoo</artifactId>
            <version>${djl.version}</version>
        </dependency>
        <dependency>
            <groupId>commons-cli</groupId>
            <artifactId>commons-cli</artifactId>
            <version>1.9.0</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>2.0.16</version>
        </dependency>
    </dependencies>

    <!-- One engine per run: -Pjitnn, -Ppytorch or -Ponnxruntime (ONNX Runtime with CUDA). -->
    <profiles>
        <profile>
            <id>jitnn</id>
            <dependencies>
                <dependency>
                    <groupId>io.github.beehive-lab</groupId>
                    <artifactId>jitnn-djl</artifactId>
                    <version>0.1.0-SNAPSHOT</version>
                </dependency>
                <!-- only for the ai.djl.onnxruntime model zoo that YoloDetection's djl:// URL names -->
                <dependency>
                    <groupId>ai.djl.onnxruntime</groupId>
                    <artifactId>onnxruntime-engine</artifactId>
                    <version>${djl.version}</version>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>pytorch</id>
            <dependencies>
                <dependency>
                    <groupId>ai.djl.pytorch</groupId>
                    <artifactId>pytorch-engine</artifactId>
                    <version>${djl.version}</version>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>onnxruntime</id>
            <dependencies>
                <dependency>
                    <groupId>ai.djl.onnxruntime</groupId>
                    <artifactId>onnxruntime-engine</artifactId>
                    <version>${djl.version}</version>
                    <exclusions>
                        <exclusion>
                            <groupId>com.microsoft.onnxruntime</groupId>
                            <artifactId>onnxruntime</artifactId>
                        </exclusion>
                    </exclusions>
                </dependency>
                <dependency>
                    <groupId>com.microsoft.onnxruntime</groupId>
                    <artifactId>onnxruntime_gpu</artifactId>
                    <version>${ort.version}</version>
                </dependency>
                <!-- ONNX Runtime engine hands image pre-processing to PyTorch, as DJL documents -->
                <dependency>
                    <groupId>ai.djl.pytorch</groupId>
                    <artifactId>pytorch-engine</artifactId>
                    <version>${djl.version}</version>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
</project>
