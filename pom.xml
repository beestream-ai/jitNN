<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>ai.beestream</groupId>
    <artifactId>jitnn-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>jitNN</name>
    <description>A machine-learning and deep-learning library for the JVM with every operator written as a TornadoVM kernel</description>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <modules>
        <module>jitnn-core</module>
        <module>jitnn-nn</module>
        <module>jitnn-onnx</module>
        <module>jitnn-gguf</module>
        <module>jitnn-djl</module>
        <module>jitnn-tf</module>
        <module>jitnn-bench</module>
        <module>jitnn-examples</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>22</maven.compiler.release>
        <!-- jitNN needs TornadoVM develop (8.0.1-dev): the on-demand
             TornadoExecutionPlan.transferToDevice(Object...) moves parameters between plans, the
             library tasks (TaskGraph.libraryTask) call cuBLAS, cuDNN, cuFFT, cuSPARSE and MLX, and
             withDynamicShapes() shares kernels across array sizes. -->
        <tornadovm.version>8.0.1-jdk22plus-dev</tornadovm.version>
        <junit.version>5.10.1</junit.version>
        <!-- Device for accelerator tests, as <driver>:<device> listed by the tornado devices command. -->
        <jitnn.test.device>0:0</jitnn.test.device>
        <jitnn.test.verbose>false</jitnn.test.verbose>
        <jitnn.test.profile>false</jitnn.test.profile>
        <jitnn.test.gemm>auto</jitnn.test.gemm>
        <jitnn.test.extra></jitnn.test.extra>
        <jitnn.test.backend>tornado</jitnn.test.backend>
        <!-- TornadoVM's device-memory budget for the accelerator tests (its default is 4GB). -->
        <jitnn.test.deviceMemory>12GB</jitnn.test.deviceMemory>
        <!-- Directory with the MNIST IDX files; the MNIST gate test is skipped when empty. -->
        <jitnn.mnist></jitnn.mnist>
        <jitnn.hf></jitnn.hf>
        <!-- Directory with cifar-10-batches-bin; the CIFAR-10 gates are skipped when empty. -->
        <jitnn.cifar10></jitnn.cifar10>
        <!-- Directory with corpus.txt and the PyTorch references; the transformer gates are skipped when empty. -->
        <jitnn.text></jitnn.text>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.github.beehive-lab</groupId>
                <artifactId>tornado-api</artifactId>
                <version>${tornadovm.version}</version>
                <scope>provided</scope>
            </dependency>
            
            <!-- vendor library tasks (-Djitnn.native); the TornadoVM SDK provides them at run time -->
            <dependency>
                <groupId>io.github.beehive-lab</groupId>
                <artifactId>tornado-cublas</artifactId>
                <version>${tornadovm.version}</version>
                <scope>provided</scope>
                <exclusions>
                    <exclusion>
                        <groupId>*</groupId>
                        <artifactId>*</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>
            <dependency>
                <groupId>io.github.beehive-lab</groupId>
                <artifactId>tornado-cudnn</artifactId>
                <version>${tornadovm.version}</version>
                <scope>provided</scope>
                <exclusions>
                    <exclusion>
                        <groupId>*</groupId>
                        <artifactId>*</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>
            <dependency>
                <groupId>io.github.beehive-lab</groupId>
                <artifactId>tornado-cufft</artifactId>
                <version>${tornadovm.version}</version>
                <scope>provided</scope>
                <exclusions>
                    <exclusion>
                        <groupId>*</groupId>
                        <artifactId>*</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>
            <dependency>
                <groupId>io.github.beehive-lab</groupId>
                <artifactId>tornado-cusparse</artifactId>
                <version>${tornadovm.version}</version>
                <scope>provided</scope>
                <exclusions>
                    <exclusion>
                        <groupId>*</groupId>
                        <artifactId>*</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>
            <dependency>
                <groupId>io.github.beehive-lab</groupId>
                <artifactId>tornado-mlx</artifactId>
                <version>${tornadovm.version}</version>
                <scope>provided</scope>
                <exclusions>
                    <exclusion>
                        <groupId>*</groupId>
                        <artifactId>*</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>
            <dependency>
                <groupId>io.github.beehive-lab</groupId>
                <artifactId>tornado-cutlass</artifactId>
                <version>${tornadovm.version}</version>
                <scope>provided</scope>
                <exclusions>
                    <exclusion>
                        <groupId>*</groupId>
                        <artifactId>*</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>
            <dependency>
                <groupId>io.github.beehive-lab</groupId>
                <artifactId>tornado-nccl</artifactId>
                <version>${tornadovm.version}</version>
                <scope>provided</scope>
                <exclusions>
                    <exclusion>
                        <groupId>*</groupId>
                        <artifactId>*</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>
            <dependency>
                <groupId>ai.beestream</groupId>
                <artifactId>jitnn-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter-api</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter-engine</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                    <!-- the CPU backend's kernels use the Vector API (an incubator module) -->
                    <configuration>
                        <compilerArgs>
                            <arg>--add-modules</arg>
                            <arg>jdk.incubator.vector</arg>
                        </compilerArgs>
                    </configuration>
                </plugin>
                <!-- Default tests run on the CPU reference backend and need no accelerator.
                     *AccelTest classes run under -Paccel-tests, on the TornadoVM SDK in TORNADOVM_HOME. -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.2</version>
                    <configuration>
                        <excludes>
                            <exclude>**/*AccelTest.java</exclude>
                        </excludes>
                        <trimStackTrace>false</trimStackTrace>
                        <argLine>--add-modules jdk.incubator.vector ${jitnn.test.extra}</argLine>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <!-- API documentation: ./mvnw install -DskipTests && ./mvnw javadoc:aggregate
                 writes one site for every module to target/reports/apidocs. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.11.2</version>
                <configuration>
                    <doctitle>jitNN ${project.version} API</doctitle>
                    <windowtitle>jitNN ${project.version} API</windowtitle>
                    <!-- Check HTML and references; members without comments are allowed. -->
                    <doclint>all,-missing</doclint>
                    <skippedModules>jitnn-bench</skippedModules>
                    <!-- the CPU backend uses the Vector API -->
                    <additionalOptions>
                        <additionalOption>--add-modules</additionalOption>
                        <additionalOption>jdk.incubator.vector</additionalOption>
                    </additionalOptions>
                    <groups>
                        <group>
                            <title>Core: tensors and autograd; operators and kernels</title>
                            <packages>ai.beestream.jitnn:ai.beestream.jitnn.engine*:ai.beestream.jitnn.ops*:ai.beestream.jitnn.kernels*:ai.beestream.jitnn.natives*:ai.beestream.jitnn.dist*:ai.beestream.jitnn.io*</packages>
                        </group>
                        <group>
                            <title>Neural networks and models; classical machine learning</title>
                            <packages>ai.beestream.jitnn.nn*:ai.beestream.jitnn.ml*:ai.beestream.jitnn.data*</packages>
                        </group>
                        <group>
                            <title>Importers and integrations</title>
                            <packages>ai.beestream.jitnn.onnx*:ai.beestream.jitnn.gguf*:ai.beestream.jitnn.tf*:ai.beestream.jitnn.djl*:ai.beestream.jitnn.llm*</packages>
                        </group>
                    </groups>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- jitnn-llm: needs jitllm installed in the local repository (./mvnw install in a jitllm checkout) -->
        <profile>
            <id>llm</id>
            <modules>
                <module>jitnn-llm</module>
            </modules>
        </profile>
        <profile>
            <id>accel-tests</id>
            <build>
                <pluginManagement>
                    <plugins>
                        <plugin>
                            <groupId>org.apache.maven.plugins</groupId>
                            <artifactId>maven-surefire-plugin</artifactId>
                            <configuration>
                                <excludes combine.self="override"/>
                                <!-- TornadoVM's Graal plugin checks fail under -ea on JDK 22+; the tornado launcher runs without it. -->
                                <enableAssertions>false</enableAssertions>
                                <includes>
                                    <include>**/*AccelTest.java</include>
                                </includes>
                                <argLine>@${env.TORNADOVM_HOME}/tornado-argfile --add-modules jdk.incubator.vector
                                    -Dtornado.recover.bailout=False
                                    -Dtornado.device.memory=${jitnn.test.deviceMemory}
                                    -Djitnn.device=${jitnn.test.device}
                                    -Djitnn.test.backend=${jitnn.test.backend}
                                    -Djitnn.verbose=${jitnn.test.verbose}
                                    -Djitnn.mnist=${jitnn.mnist}
                                    -Djitnn.hf=${jitnn.hf}
                                    -Djitnn.cifar10=${jitnn.cifar10}
                                    -Djitnn.text=${jitnn.text}
                                    -Djitnn.profile=${jitnn.test.profile}
                                    -Djitnn.gemm=${jitnn.test.gemm} ${jitnn.test.extra}</argLine>
                            </configuration>
                        </plugin>
                    </plugins>
                </pluginManagement>
            </build>
        </profile>
    </profiles>
</project>
