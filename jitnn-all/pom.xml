<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ai.beestream</groupId>
        <artifactId>jitnn-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>jitnn-all</artifactId>
    <name>jitNN (one jar)</name>
    <description>jitnn-core, -nn, -onnx, -tf, -gguf and -djl in one jar for the class path. TornadoVM comes from its SDK and DJL from the application, so neither is inside.</description>

    <properties>
        <!-- attached to GitHub releases only; Maven users depend on the modules -->
        <maven.deploy.skip>true</maven.deploy.skip>
        <maven.install.skip>true</maven.install.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>ai.beestream</groupId>
            <artifactId>jitnn-core</artifactId>
        </dependency>
        <dependency>
            <groupId>ai.beestream</groupId>
            <artifactId>jitnn-nn</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ai.beestream</groupId>
            <artifactId>jitnn-onnx</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ai.beestream</groupId>
            <artifactId>jitnn-tf</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ai.beestream</groupId>
            <artifactId>jitnn-gguf</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ai.beestream</groupId>
            <artifactId>jitnn-djl</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <!-- the jar carries the license and the third-party notices -->
            <resource>
                <directory>${project.basedir}/..</directory>
                <includes>
                    <include>LICENSE</include>
                    <include>NOTICE</include>
                </includes>
                <targetPath>META-INF</targetPath>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <artifactSet>
                                <includes>
                                    <include>ai.beestream:*</include>
                                </includes>
                            </artifactSet>
                            <transformers>
                                <!-- the modules register passes, library probes and the DJL engine here -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
